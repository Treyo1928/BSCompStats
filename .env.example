# ---------------------------------------------------------------------------
# BSCompStats configuration
# Copy to .env and fill in. Everything with a default works out of the box for
# a local `docker compose up`; only the OAuth apps must be registered by you.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# The public URL the site is reached at. Must match the OAuth redirect URIs.
APP_URL=http://localhost:3000

# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-openssl-rand-base64-32

# --- Database ---------------------------------------------------------------
POSTGRES_USER=bscs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bscompstats
# Host/port are the compose service names; override if using an external DB.
DATABASE_URL=postgresql://bscs:change-me@postgres:5432/bscompstats?schema=public

# --- Redis (job queue + live fan-out) ---------------------------------------
REDIS_URL=redis://redis:6379

# --- Sign-in ----------------------------------------------------------------
# Step-by-step walkthrough for both providers: docs/auth-setup.md

# --- Discord OAuth ----------------------------------------------------------
# https://discord.com/developers/applications -> OAuth2
# Redirect URI: ${APP_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- BeatLeader OAuth -------------------------------------------------------
# Lets a player prove they own a BeatLeader profile, auto-linking their scores.
# https://beatleader.com/developer -> new OAuth2 application, scope: profile
# The Application ID you choose there is the client ID.
# Redirect URI: ${APP_URL}/api/auth/callback/beatleader
BEATLEADER_CLIENT_ID=
BEATLEADER_CLIENT_SECRET=

# --- Admin bootstrap --------------------------------------------------------
# There is no password login, so the first admin is granted here.
# Comma-separated Discord user IDs and/or email addresses; anyone matching is
# promoted to ADMIN when they sign in.
BOOTSTRAP_ADMINS=
# When true (default) the very first account to sign in becomes ADMIN. Turn off
# once your admins exist if the instance is publicly reachable.
FIRST_USER_IS_ADMIN=true

# --- Score ingestion --------------------------------------------------------
# Live feed of every score on BeatLeader; we filter it to tracked players.
BEATLEADER_WS_URL=wss://sockets.api.beatleader.com/scores
BEATLEADER_API_URL=https://api.beatleader.com
# Set false to rely on polling alone.
ENABLE_LIVE_SOCKET=true
# Background re-poll of tracked scores. Cheap safety net behind the socket.
SCORE_POLL_INTERVAL_SECONDS=300
# Parallel requests to the BeatLeader API. Keep modest - be a good citizen.
BEATLEADER_CONCURRENCY=4

# --- Optional: Discord notifications ----------------------------------------
# Posts when a match map completes and when a match ends. Leave blank to disable.
DISCORD_WEBHOOK_URL=

# --- Tuning -----------------------------------------------------------------
# Monte Carlo samples for win-probability and lineup recommendations.
SIM_ITERATIONS=20000
